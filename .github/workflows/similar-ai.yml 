name: Similar + AI Filter

on:
  schedule:
    - cron: "0 8 * * *"  # каждый день в 08:00 UTC
  workflow_dispatch:

jobs:
  run-pipeline:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      models: read  # для GitHub Models
    
    steps:
      - uses: actions/checkout@v4
      
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      
      - name: Install dependencies
        run: |
          pip install -r requirements.txt
          # Скачиваем Xray если нужен
          curl -sL https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip -o xray.zip
          unzip -o xray.zip xray -d .
          chmod +x xray
          export XRAY_BIN=$PWD/xray
      
      - name: Run collector
        run: python collector.py
        env:
          XRAY_BIN: ${{ env.XRAY_BIN }}
      
      - name: Run similar
        run: python similar.py --pool work/pool.txt --top 150
      
      - name: Run AI filter
        run: python ai_filter.py
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      
      - name: Commit results
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add out/
          git diff --cached --quiet || {
            git commit -m "Update similar + AI picks: $(date -u +%Y-%m-%d)"
            git push
          }
