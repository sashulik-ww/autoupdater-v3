name: similar-ai

on:
  workflow_dispatch:
  schedule:
    - cron: "0 8 * * *"

jobs:
  run-pipeline:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Setup Xray
        run: |
          curl -sL -o xray.zip https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip
          unzip -o xray.zip xray
          chmod +x xray
          echo "XRAY_BIN=$PWD/xray" >> "$GITHUB_ENV"

      - name: Run collector
        run: python collector.py --pool-out work/pool.txt

      - name: Run similar
        run: python similar.py --pool work/pool.txt --top 150

      - name: Run AI filter
        run: python ai_filter.py
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}

      - name: Commit results
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add out || true
          git add work || true
          git diff --cached --quiet || git commit -m "AI picks"
          git push || true
